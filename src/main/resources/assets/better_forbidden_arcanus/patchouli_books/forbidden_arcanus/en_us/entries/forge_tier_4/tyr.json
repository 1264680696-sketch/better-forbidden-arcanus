    {
      "type": "patchouli:text",
      "title": "Avatar of Tyr",
      "text": "Tyr armor grants these benefits:$(br2)Pure Gold: Piglins remain neutral.$(br)Water Dragon's Gift: each piece increases swimming speed.$(br2)One piece unlocks Valor: each harmful effect increases your attributes, up to five effects. Nearby enemies also increase them."
    },
    {
      "type": "patchouli:text",
      "title": "Avatar of Tyr",
      "text": "Two pieces unlock Justice: enemies with more health than you take increased damage; those with less take reduced damage."
    },
    {
      "type": "patchouli:text",
      "title": "Avatar of Tyr",
      "text": "With a full set:$(br2)Severed Hand: you cannot hold an offhand shield, and projectile damage is reduced.$(br2)Unyielding: a fatal hit leaves half a heart; your next attack deals 500% damage. Cooldown: 120 seconds."
    }
