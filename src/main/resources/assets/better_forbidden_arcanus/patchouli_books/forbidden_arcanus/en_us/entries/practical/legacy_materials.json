{
  "name": "头骨与符文袋",
  "category": "better_forbidden_arcanus:practical",
  "icon": "better_forbidden_arcanus:rune_bag",
  "sortnum": 31,
  "pages": [
    {
      "type": "patchouli:text",
      "title": "收拢残片",
      "text": "头骨是符文战斧的材料，以四个骨块按菱形排列制成，别把它认作骷髅头颅。四枚符文可压成一袋，便于保存，也能再拆回四枚。"
    },
    {
      "type": "patchouli:crafting",
      "recipe": "better_forbidden_arcanus:skull",
      "text": "四个骨块菱形排列，中央留空。"
    },
    {
      "type": "patchouli:crafting",
      "recipe": "better_forbidden_arcanus:rune_bag",
      "text": "四枚符文压成一袋；无序合成可拆回四枚。"
    },
    {
      "type": "patchouli:crafting",
      "recipe": "better_forbidden_arcanus:dark_rune_bag",
      "text": "暗黑符文同样可以成袋；普通符文袋也可交给核心，一次转化整袋。"
    }
  ]
}
